# GDL-Web Environment Configuration
# Copy this file to .env and replace placeholder values before running.

# Runtime environment: development | production | testing
APP_ENV=development

# Server bind settings (defaults to localhost for safe local development)
HOST=127.0.0.1
PORT=6969

# Unified storage directory (contains downloads/, db/, and tmp_cookies/)
# In Docker / Render, this is set to /app/storage.
STORAGE_DIR=storage

# Session signing secret (REQUIRED in production)
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_char_hex_secret

# Fernet key for encrypting stored user cookies at rest (REQUIRED in production)
# Must be a valid 32-byte url-safe base64-encoded Fernet key.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIES_ENCRYPTION_KEY=replace_with_a_valid_fernet_key

# Allow runtime pip updates of gallery-dl/yt-dlp via API (keep false in containers/production)
ENABLE_RUNTIME_UPDATES=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Multi-user quotas and retention
MAX_CONCURRENT_DOWNLOADS_GLOBAL=6
MAX_CONCURRENT_DOWNLOADS_PER_SESSION=2
MAX_FILESIZE_MB=500
DOWNLOAD_TTL_SECONDS=3600
